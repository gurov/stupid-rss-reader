    <item>
        <title>Frames, forms, base, meta, styles, clobbering</title>
        <link>https://evil.example/3</link>
        <content:encoded><![CDATA[
            <iframe src="javascript:window.__pwned='iframe'"></iframe>
            <iframe srcdoc="&lt;script&gt;parent.__pwned='srcdoc'&lt;/script&gt;"></iframe>
            <object data="javascript:window.__pwned='object'"></object>
            <embed src="javascript:window.__pwned='embed'">
            <form action="javascript:window.__pwned='form'"><input name="q" autofocus onfocus="window.__pwned='onfocus'"><button>go</button></form>
            <base href="javascript:/a/">
            <meta http-equiv="refresh" content="0;url=javascript:window.__pwned='meta'">
            <link rel="stylesheet" href="https://evil.example/x.css">
            <style>body { background: url(https://evil.example/track.png) }</style>
            <p style="background:url(https://evil.example/t.png)">styled</p>
            <img id="getElementById" name="body" src="https://ok.example/c.png">
            <form name="cookie"></form>
            <div class="toolbar" data-x="1" aria-hidden="true">attributes</div>
            <template><img src="x" onerror="window.__pwned='template'"></template>
        ]]></content:encoded>
    </item>

