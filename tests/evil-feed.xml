        <guid>evil-1</guid>
        <media:thumbnail url="javascript:window.__pwned='thumbnail'"/>
        <enclosure url="javascript:window.__pwned='enclosure'" type="text/html" length="1"/>
        <content:encoded><![CDATA[
            <p>Scripts and handlers</p>
            <script>window.__pwned='script'</script>
            <img src="x" onerror="window.__pwned='img onerror'">
            <svg onload="window.__pwned='svg onload'"><circle r="10"/></svg>
            <svg><use href="data:image/svg+xml,&lt;svg id='x' xmlns='http://www.w3.org/2000/svg'&gt;&lt;image href='x' onerror='window.__pwned=1'/&gt;&lt;/svg&gt;#x"/></svg>
            <details open ontoggle="window.__pwned='ontoggle'"><summary>s</summary>d</details>
            <body onload="window.__pwned='body onload'">
            <video><source onerror="window.__pwned='source onerror'"></video>
            <audio src="x" onerror="window.__pwned='audio onerror'"></audio>
            <a href="https://ok.example/" onclick="window.__pwned='onclick'" target="_self">ok link</a>
        ]]></content:encoded>
    </item>

